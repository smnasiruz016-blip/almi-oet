{
  "name": "almi-oet",
  "version": "0.1.0",
  "private": true,
  "description": "AlmiOET — AI-powered Occupational English Test (OET) practice for healthcare professionals (0–500 scale, A–E grade per sub-test, 12 professions) in the AlmiWorld family. Separate product (almioet.almiworld.com). Original content — never copied from OET/CBLA. Practice estimates only; confirm requirements with your regulator.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run gate:all && next build",
    "db:deploy": "prisma migrate deploy",
    "seed:prod": "tsx scripts/seed/append.ts",
    "gate:all": "tsx scripts/gates/run.ts && tsx scripts/gates/sources.ts && tsx scripts/gates/audio.ts && tsx scripts/gates/timing.tsx && tsx scripts/gates/accept-lists.ts && tsx scripts/gates/length.ts && tsx scripts/gates/wraps.ts && tsx scripts/gates/exam-numbers.ts && tsx scripts/gates/distractor.ts && tsx scripts/gates/no-secret-shape.ts && tsx scripts/gates/claims.ts && tsx scripts/gates/title-collision.ts && tsx scripts/gates/partc-kind.ts && tsx scripts/gates/dates.ts && tsx scripts/gates/sourced-facts.ts && tsx scripts/validate-seed.ts",
    "gate:accept-lists": "tsx scripts/gates/accept-lists.ts",
    "gate:length": "tsx scripts/gates/length.ts",
    "gate:wraps": "tsx scripts/gates/wraps.ts",
    "gate:exam-numbers": "tsx scripts/gates/exam-numbers.ts",
    "gate:distractor": "tsx scripts/gates/distractor.ts",
    "gate:claims": "tsx scripts/gates/claims.ts",
    "gate:title-collision": "tsx scripts/gates/title-collision.ts",
    "build:reading-sets": "tsx scripts/seed/gen/_build_reading_sets.mts",
    "gate:partc-kind": "tsx scripts/gates/partc-kind.ts",
    "gate:dates": "tsx scripts/gates/dates.ts",
    "gate:sourced-facts": "tsx scripts/gates/sourced-facts.ts",
    "apply:partc-kind": "tsx scripts/seed/gen/_apply_partc_kind.mts",
    "gate:no-secret-shape": "tsx scripts/gates/no-secret-shape.ts",
    "gate:sources": "tsx scripts/gates/sources.ts",
    "gate:audio": "tsx scripts/gates/audio.ts",
    "gate:timing": "tsx scripts/gates/timing.tsx",
    "gate:next-exercise": "vitest run tests/next-exercise-chain.test.ts",
    "gate:pool-visible": "vitest run tests/pool-visible.test.tsx",
    "gate:progress-visible": "vitest run tests/progress-visible.test.tsx",
    "gate:trial-cap": "vitest run tests/trial-cap-costs-nothing.test.ts",
    "gate:chain-is-paid": "vitest run tests/chain-is-paid.test.ts",
    "gate:scale": "vitest run tests/scale.test.ts",
    "gate:chain": "npm run gate:next-exercise && npm run gate:pool-visible && npm run gate:progress-visible && npm run gate:trial-cap && npm run gate:chain-is-paid",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e/run.mts",
    "check:prod-migrations": "tsx scripts/check-prod-migrations.mts",
    "gate:no-tokens-for-nothing": "tsx scripts/measure/blank-submit.mts",
    "test:db": "tsx scripts/measure/blank-submit.mts",
    "report:shape": "tsx scripts/report-shape.ts",
    "start": "next start",
    "postinstall": "prisma generate",
    "seed:listening": "tsx scripts/seed/listening.ts",
    "seed:reading": "tsx scripts/seed/reading.ts",
    "seed:writing": "tsx scripts/seed/writing-letter.ts",
    "seed:speaking": "tsx scripts/seed/speaking-roleplay.ts",
    "seed:all": "npm run seed:listening && npm run seed:reading && npm run seed:writing && npm run seed:speaking",
    "seed:append": "tsx scripts/seed/append.ts",
    "audio:render": "tsx scripts/render-audio.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@prisma/client": "^6.19.3",
    "@smnasiruz016-blip/almi-data": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "stripe": "^22.1.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.10.0-beta.17",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
